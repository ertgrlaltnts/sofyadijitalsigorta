PORT=4000
# Number of reverse proxies (nginx) in front of the API. 1 behind a single nginx; 0 when reached directly.
TRUST_PROXY=0
MONGODB_URI=mongodb://localhost:27017/sofya_chat
JWT_SECRET=
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Production: CORS_ORIGINS=https://www.sofyadijitalsigorta.com,https://sofyadijitalsigorta.com,https://pnlsf.sofyadijitalsigorta.com
CORS_ORIGINS=http://localhost:4002,http://localhost:4001
ADMIN_EMAIL=
ADMIN_PASSWORD=

# IO quote API (2C). The token stays on the server only; leave empty to disable /api/quotes.
IO_API_URL=https://online.sofyadijitalsigorta.com
IO_API_TOKEN=
IO_FIRMA_KODU=2286
IO_PROGRAM=io_dijital
IO_CHANNEL=1

# Card payment on the website (POST /api/quotes/:id/purchase). Keep false until payments are tested with 2C.
QUOTE_PURCHASE_ENABLED=false
